<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows (Android 12+): the widget's look with a sample verse. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_title"
        android:textColor="#D9B25C"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:text="@string/widget_preview_verse"
        android:textColor="#F1ECE1"
        android:textSize="16sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_continue"
        android:textColor="#B0AA9D"
        android:textSize="13sp" />
</LinearLayout>
