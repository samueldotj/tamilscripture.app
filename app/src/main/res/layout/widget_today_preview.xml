<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows (Android 12+): the verse widget, medium, with a sample verse. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp">
    <TextView
        style="@style/WidgetPreviewText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:text="@string/widget_preview_title"
        android:textColor="#7D5411"
        android:textSize="10sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#29201F1D" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/widget_tamil_mukta"
        android:text="@string/widget_preview_verse"
        android:textColor="#201F1D"
        android:textSize="18sp" />
    <TextView
        style="@style/WidgetPreviewText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_reference"
        android:textColor="#201F1D"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
