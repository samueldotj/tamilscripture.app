{"version":"IRVTAM","book":"PSA","chapter":23,"build":"b701b68a7b","label":"சங்கீதம் 23","blocks":[{"type":"para","style":"d","segments":[{"text":"தாவீதின் பாடல்."}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.1","n":"1","text":"யெகோவா என் மேய்ப்பராக இருக்கிறார்;"}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.1","text":"நான் தாழ்ச்சி அடையமாட்டேன்."}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.2","n":"2","text":"அவர் என்னைப் புல்லுள்ள இடங்களில் மேய்த்து,"}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.2","text":"அமர்ந்த தண்ணீர்கள் அருகில் என்னைக் கொண்டுபோய்விடுகிறார்."}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.3","n":"3","text":"அவர் என் ஆத்துமாவைத் தேற்றி, தம்முடைய பெயரினிமித்தம் என்னை நீதியின் பாதைகளில் நடத்துகிறார்."}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.4","n":"4","text":"நான் மரண இருளின் பள்ளத்தாக்கிலே நடந்தாலும்"}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.4","text":"பொல்லாப்புக்குப் பயப்படமாட்டேன்;"}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.4","text":"ஏனெனில் தேவனே நீர் என்னோடு இருக்கிறீர்;"}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.4","text":"உமது கோலும் உமது தடியும் என்னைத் தேற்றும்."}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.5","n":"5","text":"என்னுடைய எதிரிகளுக்கு முன்பாக நீர் எனக்கு ஒரு பந்தியை ஆயத்தப்படுத்தி,"}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.5","text":"என்னுடைய தலையை எண்ணெயால் அபிஷேகம்செய்கிறீர்;"}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.5","text":"என்னுடைய பாத்திரம் நிரம்பி வழிகிறது.","notes":[{"kind":"f","at":35,"caller":"+","reference":"23:5","text":"லூக்கா 7:46."}]}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.6","n":"6","text":"என் உயிருள்ள நாளெல்லாம் நன்மையும் கிருபையும் என்னைத் தொடரும்;"}]},{"type":"para","style":"q1","segments":[{"id":"PSA.23.6","text":"நான் யெகோவாவுடைய வீட்டிலே நீடித்த நாட்களாக நிலைத்திருப்பேன்."}]}],"prev":{"book":"PSA","chapter":22},"next":{"book":"PSA","chapter":24},"audio":{"src":"https://stream.tamilaudiobible.com/IRVTAM/r1/PSA/PSA_023.mp3","ms":52704,"timed":true}}
