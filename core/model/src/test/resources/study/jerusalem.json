.20.22","ACT.21.4","ACT.21.11","ACT.21.12","ACT.21.13","ACT.21.15","ACT.21.17","ACT.21.18","ACT.21.21","ACT.21.31","ACT.22.3","ACT.22.5","ACT.22.17","ACT.22.18","ACT.23.11","ACT.24.11","ACT.24.17","ACT.25.1","ACT.25.3","ACT.25.7","ACT.25.9","ACT.25.15","ACT.25.20","ACT.25.24","ACT.26.4","ACT.26.10","ACT.26.20","ACT.28.17","ROM.15.19","ROM.15.25","ROM.15.26","ROM.15.27","ROM.15.31","1CO.16.1","1CO.16.3","2CO.8.4","2CO.8.19","2CO.9.1","2CO.9.12","GAL.1.17","GAL.1.18","GAL.2.1","GAL.4.25","GAL.4.26","HEB.12.22","REV.3.12","REV.11.8","REV.21.2","REV.21.10"],"journeys":["ark","sennacherib","exile","return","nativity","jesus-early","jesus-final","resurrection","jesus-ministry","philip","saul-conversion","peter-coast","paul-2","paul-3"],"nearby":[{"id":"angle","name_en":"Angle","name_ta":"கடைசிமுனை","qualifier":null},{"id":"ariel","name_en":"Ariel","name_ta":"அரியேல்","qualifier":null},{"id":"baal-hamon","name_en":"Baal-hamon","name_ta":"பாகால் ஆமோன்","qualifier":null},{"id":"beautiful-gate","name_en":"Beautiful Gate","name_ta":"அலங்கார வாசல்","qualifier":null},{"id":"benjamin-gate","name_en":"Benjamin Gate","name_ta":"பென்யமீன்","qualifier":null},{"id":"beyond-the-river","name_en":"Beyond the River","name_ta":"நதிக்கு","qualifier":null},{"id":"corner-gate","name_en":"Corner Gate","name_ta":"மூலைவாசல்","qualifier":null},{"id":"dung-gate","name_en":"Dung Gate","name_ta":"குப்பைமேட்டு","qualifier":null},{"id":"east-gate","name_en":"East Gate","name_ta":"கிழக்குவாசலைக்","qualifier":null},{"id":"east-square","name_en":"East Square","name_ta":"கிழக்கு வீதி","qualifier":null},{"id":"ephraim-gate","name_en":"Ephraim Gate","name_ta":"எப்பிராயீம்","qualifier":null},{"id":"fish-gate","name_en":"Fish Gate","name_ta":"மீன்வாசலை","qualifier":null}],"description":{"brief":"The capital of Israel, a holy city for three religions","short":"Jerusalem, the capital of Israel and a holy city for Judaism, Christianity, and Islam.","article":"Jerusalem is one of the most important cities in the Bible, serving as the capital of Israel and a holy city for Judaism, Christianity, and Islam. It is mentioned hundreds of times throughout the Old and New Testaments. The city was originally known as Salem (Genesis 14:18; Psalm 76:2) and was later called Jebus, after the Jebusites who inhabited it (Judges 19:10; 1Ch.11.4). David conquered the city and made it his capital (2Sa.5.6-9; 1Ch.11.4-9). Solomon built the first temple in Jerusalem (1Kings 6-8; 2Chronicles 3-7), which became the center of Jewish worship. The city was destroyed by the Babylonians in 586 BC (2Ki.25.1-10; 2Ch.36.17-19) but was later rebuilt after the exile (Ezra 1:1-4; Nehemiah 2:11-20). In the New Testament, Jerusalem is the site of many events in the life of Jesus, including his triumphal entry (Matthew 21:1-11), cleansing of the temple (Matthew 21:12-17), and crucifixion (Matthew 27:32-56). The early church also began in Jerusalem (Acts 1-7). Throughout the Bible, Jerusalem is referred to by various names, each highlighting a different aspect of its significance: Ariel (Isaiah 29:1), My Delight Is in Her (Isaiah 62:4), Forsaken and Desolate (Isaiah 62:4), Married (Isaiah 62:4), the City of the Lord (Isaiah 60:14), Zion (Psalm 87:2), and Mount Zion (Psalm 48:1). The name \"Jerusalem\" itself may mean \"foundation of peace\" or \"possession of peace.\"","source":"STEP Bible","licence":"CC BY 4.0","url":"https://www.stepbible.org"},"articles":[{"source":"eastons","id":"eastons/jerusalem","title":"Jerusalem","paragraphs":8},{"source":"smiths","id":"smiths/jerusalem","title":"Jerusalem","paragraphs":2},{"source":"aquifer","id":"aquifer/ariel-place","title":"Ariel (Place)","paragraphs":3},{"source":"aquifer","id":"aquifer/beulah","title":"Beulah","paragraphs":2},{"source":"aquifer","id":"aquifer/daughter-of-zion","title":"Daughter of Zion","paragraphs":2},{"source":"aquifer","id":"aquifer/hephzibah","title":"Hephzibah","paragraphs":2},{"source":"aquifer","id":"aquifer/jebus-jebusite","title":"Jebus, Jebusite","paragraphs":6},{"source":"aquifer","id":"aquifer/jerusalem","title":"Jerusalem","paragraphs":64},{"source":"aquifer","id":"aquifer/new-jerusalem","title":"New Jerusalem","paragraphs":40}],"source":{"openbible_id":"a15257a","url":"https://www.openbible.info/geo/ancient/a15257a/jerusalem","licence":"CC BY 4.0","attribution":"OpenBible.info Bible Geocoding, CC BY 4.0"}}
